{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Расчёт потребляемой датацентром электроэнергии по установленному оборудованию",
        "title": "Datacenter Power API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api",
    "paths": {
        "/datacenter-engineers/sign-in": {
            "post": {
                "description": "Возвращает JWT для заголовка Authorization: Bearer \u003caccess_token\u003e",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-engineers"
                ],
                "summary": "Аутентификация инженера",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterEngineerSignInRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterEngineerSignInResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                }
            }
        },
        "/datacenter-engineers/sign-out": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Добавляет текущий JWT в блеклист Redis",
                "tags": [
                    "datacenter-engineers"
                ],
                "summary": "Деавторизация инженера",
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                }
            }
        },
        "/datacenter-engineers/sign-up": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-engineers"
                ],
                "summary": "Регистрация инженера",
                "parameters": [
                    {
                        "description": "Логин и пароль",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterEngineerSignUpRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterEngineer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    }
                }
            }
        },
        "/datacenter-equipment": {
            "get": {
                "description": "is_creator = 1, если устройство создал авторизованный инженер",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Список опубликованных устройств",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Мощность от, Вт",
                        "name": "power",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ds.DatacenterDeviceCardSerializer"
                            }
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Создаёт черновик текущего инженера, файлы сохраняются в MinIO",
                "consumes": [
                    "multipart/form-data"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Добавление устройства с фото и видео",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Название устройства",
                        "name": "name",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Фото (jpeg, png, webp)",
                        "name": "image",
                        "in": "formData",
                        "required": true
                    },
                    {
                        "type": "file",
                        "description": "Видео (webm, mp4)",
                        "name": "video",
                        "in": "formData",
                        "required": true
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceSerializer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    }
                }
            }
        },
        "/datacenter-equipment/draft": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Черновик устройства текущего инженера",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceSerializer"
                        }
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/datacenter-equipment/reel": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Первое устройство ленты",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceCardSerializer"
                        }
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/datacenter-equipment/reel/{id}": {
            "get": {
                "description": "При next=true возвращается следующее устройство после id",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Устройство ленты по id",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id устройства",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "true — следующее устройство",
                        "name": "next",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceCardSerializer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/datacenter-equipment/{id}": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Логическое удаление устройства текущего инженера",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id устройства",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/datacenter-equipment/{id}/like": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "like = 1 ставит лайк, like = 0 снимает",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Лайк устройства от текущего инженера",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id устройства",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Лайк",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceLikeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceSerializer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        },
        "/datacenter-equipment/{id}/publish": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "datacenter-equipment"
                ],
                "summary": "Публикация черновика устройства",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "id черновика",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Поля устройства",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDevicePublishRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ds.DatacenterDeviceSerializer"
                        }
                    },
                    "400": {
                        "description": "Bad Request"
                    },
                    "403": {
                        "description": "Forbidden"
                    },
                    "404": {
                        "description": "Not Found"
                    }
                }
            }
        }
    },
    "definitions": {
        "ds.DatacenterDeviceCardSerializer": {
            "type": "object",
            "properties": {
                "heat_dissipation_btu": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "is_creator": {
                    "type": "integer"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power_consumption_w": {
                    "type": "integer"
                },
                "short_description": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterDeviceLikeRequest": {
            "type": "object",
            "required": [
                "like"
            ],
            "properties": {
                "like": {
                    "type": "integer",
                    "enum": [
                        0,
                        1
                    ]
                }
            }
        },
        "ds.DatacenterDevicePublishRequest": {
            "type": "object",
            "required": [
                "heat_dissipation_btu",
                "name",
                "power_consumption_w",
                "short_description"
            ],
            "properties": {
                "heat_dissipation_btu": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power_consumption_w": {
                    "type": "integer"
                },
                "short_description": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterDeviceSerializer": {
            "type": "object",
            "properties": {
                "heat_dissipation_btu": {
                    "type": "integer"
                },
                "id": {
                    "type": "integer"
                },
                "image_url": {
                    "type": "string"
                },
                "likes_count": {
                    "type": "integer"
                },
                "name": {
                    "type": "string"
                },
                "power_consumption_w": {
                    "type": "integer"
                },
                "short_description": {
                    "type": "string"
                },
                "video_url": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterEngineer": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "is_moderator": {
                    "type": "boolean"
                },
                "login": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterEngineerSignInRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterEngineerSignInResponse": {
            "type": "object",
            "properties": {
                "access_token": {
                    "type": "string"
                },
                "expires_in": {
                    "type": "integer"
                },
                "token_type": {
                    "type": "string"
                }
            }
        },
        "ds.DatacenterEngineerSignUpRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "Значение заголовка: Bearer \u003caccess_token\u003e",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}